        </mxCell>
        <mxCell id="5" value="EMBALAGENS&#10;─────────────────────────────────&#10;PK  id : INTEGER&#10;UK  codigo : VARCHAR(40)&#10;    nome : VARCHAR(100)&#10;    descricao : TEXT&#10;    protecao_antitranspiracao : INTEGER&#10;    eh_presente, permite_agendamento : INTEGER&#10;    preco_adicional : DECIMAL(10,2)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FAFDF9;strokeColor=#236537;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#1C1C19;fontFamily=Helvetica;" vertex="1" parent="1">
