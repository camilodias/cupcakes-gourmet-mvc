        <mxCell id="3" value="CATEGORIAS&#10;─────────────────────────────────&#10;PK  id : INTEGER&#10;UK  nome : VARCHAR(80)&#10;UK  slug : VARCHAR(80)&#10;    tipo : VARCHAR(20) [DOCE | SALGADO | ESPECIAL]&#10;    descricao : TEXT" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#2C1A1D;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#1C1C19;fontFamily=Helvetica;" vertex="1" parent="1">
