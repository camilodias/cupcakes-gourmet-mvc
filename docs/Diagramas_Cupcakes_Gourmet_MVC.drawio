        <mxCell id="4" value="CUPCAKES&#10;──────────────────────────────────────&#10;PK  id : INTEGER&#10;FK  categoria_id : INTEGER&#10;    nome : VARCHAR(120)&#10;    sabor, descricao, ingredientes : TEXT&#10;    alergenos : VARCHAR(255)&#10;    tamanho : VARCHAR(30) [Mini | Tradicional | Duplo]&#10;    preco, preco_original : DECIMAL(10,2)&#10;    imagem_svg : VARCHAR(100) [/images/*.png]&#10;    sem_gluten, zero_lactose, zero_acucar, vegano : INT&#10;    destaque, mais_vendido, promocao : INT&#10;    estoque, ativo : INTEGER" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FAFDF9;strokeColor=#236537;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#1C1C19;fontFamily=Helvetica;" vertex="1" parent="1">
